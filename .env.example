APP_ENV=development

# The default real Voice MVP uses one Alibaba Model Studio Beijing workspace.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing

LLM_PROVIDER=qwen
LLM_MODEL=qwen3.7-flash
LLM_TIMEOUT=60

STT_PROVIDER=qwen_audio
STT_MODEL=qwen-audio-3.0-asr-flash
STT_LANGUAGE_HINTS=zh,en
STT_TIMEOUT=60

TTS_PROVIDER=qwen_audio
TTS_MODEL=qwen-audio-3.0-tts-flash
TTS_VOICE=longanhuan_v3.6
TTS_SPEED=0.9
TTS_TIMEOUT=60

# Retained optional DeepSeek adapter for future advanced/complex tasks.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro
OPENAI_TIMEOUT=1800

# Retained optional MiniMax adapter; not the default TTS.
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1/t2a_v2
MINIMAX_VOICE_ID=

# development/test may set any provider selector above to fake.
