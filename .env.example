APP_ENV=development

# Fake providers are allowed only in development and test.
# FakeSTT is the no-key default until the owner selects a real provider.
STT_PROVIDER=fake
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
DASHSCOPE_REGION=cn-beijing
STT_MODEL=qwen-audio-3.0-asr-flash
STT_LANGUAGE_HINTS=zh,en
STT_TIMEOUT=60
# FakeLLM is the no-key default until the owner selects a real provider.
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-pro
OPENAI_TIMEOUT=1800
# FakeTTS is the no-key default until the owner selects a real provider.
TTS_PROVIDER=fake
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1/t2a_v2
TTS_MODEL=speech-2.8-turbo
MINIMAX_VOICE_ID=
TTS_SPEED=0.9
TTS_TIMEOUT=60
