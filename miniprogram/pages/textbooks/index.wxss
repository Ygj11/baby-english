@import "../../components/foundation/tokens.wxss";

.page { min-height: 100vh; padding: 40rpx var(--be-space-lg); background: #f5f7ff; }
.header { display: flex; flex-direction: column; margin-bottom: 28rpx; }
.title { color: #172033; font-size: 42rpx; font-weight: 700; }
.subtitle { margin-top: 10rpx; color: #697386; font-size: 27rpx; line-height: 1.5; }
.book-card, .notice-card, .empty-card { display: flex; align-items: center; gap: 22rpx; margin-bottom: 22rpx; padding: 28rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 10rpx 28rpx rgba(48, 65, 135, .08); }
.book-card--selected { border: 2rpx solid #5b6ee1; }
.book-icon { font-size: 52rpx; }
.book-main { display: flex; flex: 1; flex-direction: column; min-width: 0; }
.book-title { color: #172033; font-size: 31rpx; font-weight: 700; }
.book-meta { margin-top: 8rpx; color: #697386; font-size: 24rpx; }
.book-action { color: #5b6ee1; font-size: 25rpx; font-weight: 600; }
.notice-card, .empty-card { flex-direction: column; align-items: flex-start; color: #4e5969; }
.empty-title { color: #172033; font-size: 30rpx; font-weight: 700; }
.empty-copy { color: #697386; font-size: 25rpx; }
.status-text { display: block; padding: 50rpx 0; text-align: center; color: #697386; }
.status-text--error { color: #b42318; }
