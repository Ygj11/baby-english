@import "../../components/foundation/tokens.wxss";

.photo-page { min-height: 100vh; padding: 32rpx var(--be-space-md) 80rpx; }
.photo-hero { display: flex; flex-direction: column; margin-bottom: 28rpx; }
.photo-title { color: #172033; font-size: 42rpx; font-weight: 700; }
.photo-subtitle { margin-top: 10rpx; color: #697386; font-size: 25rpx; line-height: 1.6; }
.chooser-row { display: flex; gap: 18rpx; margin-bottom: 24rpx; }
.chooser-row t-button { flex: 1; }
.preview-card, .lesson-card, .notice-card, .pronunciation-card { padding: 24rpx; border-radius: 24rpx; background: #fff; box-shadow: 0 8rpx 28rpx rgba(51, 65, 85, .06); }
.preview-card { margin-bottom: 24rpx; }
.photo-preview { display: block; width: 100%; height: 460rpx; margin-bottom: 22rpx; border-radius: 18rpx; background: #eef1f7; }
.lesson-card { display: flex; flex-direction: column; align-items: center; }
.primary-word { color: #5b6ee1; font-size: 58rpx; font-weight: 800; text-transform: uppercase; }
.primary-meaning { margin-top: 4rpx; color: #172033; font-size: 34rpx; font-weight: 600; }
.sentence-block { display: flex; flex-direction: column; align-self: stretch; margin: 26rpx 0; padding: 22rpx; border-radius: 18rpx; background: #f5f7ff; color: #26324b; font-size: 29rpx; line-height: 1.7; }
.sentence-zh { color: #697386; }
.related-block { align-self: stretch; }
.section-label { color: #697386; font-size: 24rpx; }
.related-list { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 12rpx; }
.related-item { display: flex; gap: 8rpx; padding: 12rpx 18rpx; border-radius: 999rpx; background: #edf9f2; color: #16794a; font-size: 25rpx; }
.related-meaning { color: #5e6b7c; }
.question { margin-top: 26rpx; color: #172033; font-size: 29rpx; font-weight: 600; }
.encouragement { margin-top: 10rpx; color: #8a5b00; font-size: 25rpx; }
.action-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 14rpx; margin-top: 28rpx; }
.pronunciation-card { align-self: stretch; margin-top: 22rpx; box-shadow: none; background: #fff7dd; color: #4e5969; text-align: center; }
.score-row { display: flex; flex-direction: column; gap: 6rpx; margin-top: 12rpx; }
.score { color: #16794a; font-size: 40rpx; font-weight: 700; }
.notice-card { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 22rpx; color: #4e5969; line-height: 1.6; }
.result-notice { flex-direction: column; margin-top: 24rpx; text-align: center; }
.error-message { display: block; margin-top: 18rpx; color: #b42318; text-align: center; }
