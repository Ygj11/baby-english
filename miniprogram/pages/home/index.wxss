.page {
  min-height: 100vh;
  padding: 64rpx 40rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  margin-bottom: 40rpx;
}

.eyebrow {
  margin-bottom: 12rpx;
  color: #5b6ee1;
  font-size: 28rpx;
  font-weight: 600;
}

.title {
  color: #172033;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.3;
}

.subtitle {
  margin-top: 12rpx;
  color: #697386;
  font-size: 28rpx;
}

.entry-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.entry {
  display: flex;
  min-height: 112rpx;
  align-items: center;
  padding: 24rpx 32rpx;
  border: 2rpx solid #e5e9f5;
  border-radius: 24rpx;
  background: #ffffff;
}

.entry-icon {
  width: 72rpx;
  font-size: 44rpx;
  line-height: 1;
}

.entry-label {
  color: #25304a;
  font-size: 34rpx;
  font-weight: 600;
}
